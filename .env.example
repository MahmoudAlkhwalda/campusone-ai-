# ─────────────────────────────────────────────────────────────
# CampusOne — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────
# Required by the API server and Drizzle ORM.
# Format: postgres://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgres://postgres:your_password_here@localhost:5432/campusone

# ── AI Copilot (optional) ────────────────────────────────────
# Used by the Ask CampusOne AI Copilot (/api/copilot).
# Accepts an OpenAI API key (sk-...) or a Groq API key (gsk_...).
# If omitted, the copilot falls back to a deterministic context explanation.
OPENAI_API_KEY=your_openai_or_groq_api_key_here

# ── Server ────────────────────────────────────────────────────
# Port the API server listens on. Defaults to 5000 if unset.
PORT=5000

# ── Frontend (Vite dev server) ───────────────────────────────
# Port the Vite dev server runs on. Defaults to 3000 if unset.
# VITE_PORT=3000

# ── Node environment ──────────────────────────────────────────
NODE_ENV=development
